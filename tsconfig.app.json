{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "cn": ["./src/lib/utils.ts"],
      "@domain/*": ["./supabase/functions/_shared/domain/*"],
      "@contracts/*": ["./supabase/functions/_shared/contracts/*"]
    }
  },
  "include": [
    "src",
    "supabase/functions/_shared/domain",
    "supabase/functions/_shared/contracts",
    "supabase/functions/_shared/tenants",
    "supabase/functions/_shared/llm"
  ]
}
