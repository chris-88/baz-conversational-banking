{
  "imports": {
    "zod": "npm:zod@^4.6.5",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.131.0",
    "@anthropic-ai/sdk/": "npm:/@anthropic-ai/sdk@^0.131.0/"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "lib": [
      "deno.window",
      "esnext"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": false
  }
}
