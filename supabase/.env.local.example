# Edge Function secrets for local development.
# Loaded with: npx supabase functions serve --env-file supabase/.env.local
# Never commit the real file.

ANTHROPIC_API_KEY=
BAZ_MODEL=claude-sonnet-5-5
GATE_MODEL=claude-haiku-4-5-20251001

# Twilio (M6). Leave blank until SMS is wired up.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

SENTRY_DSN=
APP_BASE_URL=http://127.0.0.1:5173

# Audience caps (§47).
AUDIENCE_MAX_TURNS=25
AUDIENCE_MAX_CASES=50

# `fixture` is for tests only. Never used for demos or filming.
LLM_PROVIDER=anthropic
