# Browser environment. Nothing secret belongs here — every VITE_* value ships to the client.
# docs/dev/environment-variables.md explains every entry.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Must match VAPID_PUBLIC_KEY in the Edge Function secrets, or push subscriptions are
# rejected by the browser. Leave blank to run without notifications.
VITE_VAPID_PUBLIC_KEY=

# Optional. Leave blank to disable browser error reporting.
VITE_SENTRY_DSN=

# GitHub Pages base path: "/<repo>/", or "/" with a custom domain.
VITE_BASE_PATH=/
